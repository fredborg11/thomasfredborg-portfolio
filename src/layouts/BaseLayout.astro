---
const { title = "Thomas Fredborg — Graphic Designer / Art Director", description = "Portfolio of Thomas Fredborg." } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f4f0" />
    <title>{title}</title>
    <link rel="icon" href={`${base}favicon.svg`} />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label="Thomas Fredborg — home">
        <span>THOMAS</span>
        <span>FREDBORG</span>
      </a>

      <nav aria-label="Primary">
        <a href={`${base}#work`}>Work</a>
        <a href={`${base}#about`}>About</a>
        <a href="mailto:hello@thomasfredborg.dk">Contact</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        <span class="footer-label">Thomas Fredborg</span>
        <span class="footer-muted">Graphic Designer / Art Director</span>
      </div>
      <a href="mailto:hello@thomasfredborg.dk">hello@thomasfredborg.dk</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f5f4f0;
    --fg: #11110f;
    --muted: #6a6964;
    --line: #d9d7d0;
    --card: #e9e7e0;
    --max: 1480px;
  }

  * { box-sizing: border-box; }

  html {
    scroll-behavior: smooth;
    background: var(--bg);
  }

  body {
    margin: 0;
    color: var(--fg);
    background: var(--bg);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header,
  .site-footer {
    width: min(calc(100% - 56px), var(--max));
    margin: 0 auto;
  }

  .site-header {
    padding: 26px 0 18px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .wordmark {
    display: inline-flex;
    flex-direction: column;
    gap: 0;
    font-size: 11px;
    line-height: 1;
    font-weight: 750;
    letter-spacing: .09em;
  }

  .wordmark span:last-child {
    margin-top: 3px;
  }

  nav {
    display: flex;
    gap: 22px;
    font-size: 12px;
    line-height: 1;
  }

  nav a {
    color: var(--muted);
    transition: color .2s ease;
  }

  nav a:hover {
    color: var(--fg);
  }

  .site-footer {
    margin-top: 160px;
    padding: 28px 0 36px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: 30px;
    font-size: 12px;
  }

  .site-footer > div {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .footer-muted,
  .site-footer a {
    color: var(--muted);
  }

  .site-footer a:hover {
    color: var(--fg);
  }

  @media (max-width: 680px) {
    .site-header,
    .site-footer {
      width: min(calc(100% - 28px), var(--max));
    }

    .site-header {
      padding-top: 20px;
    }

    nav {
      gap: 14px;
    }

    .site-footer {
      margin-top: 110px;
      display: block;
    }

    .site-footer a {
      display: inline-block;
      margin-top: 14px;
    }
  }
</style>
