---
const {
  title = "Thomas Fredborg — Graphic Designer / Art Director",
  description = "Portfolio of Thomas Fredborg — graphic design, branding, retail, digital, packaging and print.",
  image = "",
  imageAlt = "Thomas Fredborg — Graphic Designer / Art Director"
} = Astro.props;
const canonical = Astro.url;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const siteUrl = Astro.site?.toString() ?? "https://thomasfredborg.dk/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Thomas Fredborg" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#f5f4f0" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={new URL("sitemap-index.xml", siteUrl)} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_DK" />
    <meta property="og:site_name" content="Thomas Fredborg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    {image && <meta property="og:image:alt" content={imageAlt} />}
    {image && <meta property="og:image:type" content="image/jpeg" />}
    {image && <meta name="twitter:image" content={new URL(image, Astro.site)} />}
    {image && <meta name="twitter:image:alt" content={imageAlt} />}
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": `${siteUrl}#person`,
          name: "Thomas Fredborg",
          url: siteUrl,
          jobTitle: "Graphic Designer / Art Director",
          knowsAbout: [
            "Graphic Design",
            "Art Direction",
            "Brand Identity",
            "Visual Identity",
            "Packaging Design",
            "Retail Design",
            "Digital Design",
            "UI Design",
            "Print Design",
            "Campaign Design"
          ],
          sameAs: ["https://www.linkedin.com/in/tfn/"]
        },
        {
          "@type": "WebSite",
          "@id": `${siteUrl}#website`,
          url: siteUrl,
          name: "Thomas Fredborg",
          publisher: { "@id": `${siteUrl}#person` }
        }
      ]
    })}></script>
    <link rel="icon" href={`${base}favicon.svg`} />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label="Thomas Fredborg — home">
        <span>THOMAS</span>
        <span>FREDBORG</span>
      </a>

      <nav aria-label="Primary">
        <a href={`${base}#work`}>Work</a>
        <a href={`${base}#about`}>About</a>
        <a href={`${base}#contact`}>Contact</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        <span class="footer-label">Thomas Fredborg</span>
        <span class="footer-muted">Graphic Designer / Art Director</span>
      </div>
      <div class="footer-right">
        <a href="mailto:fredborg11@gmail.com">fredborg11@gmail.com</a>
        <a href="https://www.linkedin.com/in/tfn/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      </div>
      <div class="footer-legal">
        <p>© 2026 Thomas Fredborg. Unless otherwise stated, the work shown here was designed by Thomas Fredborg. Project work may be subject to client, employer, and third-party rights. Please do not reproduce or reuse any work without permission from the relevant rights holder.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f5f4f0;
    --fg: #11110f;
    --muted: #6a6964;
    --line: #d9d7d0;
    --card: #e9e7e0;
    --max: 1480px;
  }

  * { box-sizing: border-box; }

  html {
    scroll-behavior: smooth;
    background: var(--bg);
  }

  body {
    margin: 0;
    color: var(--fg);
    background: var(--bg);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header,
  .site-footer {
    width: min(calc(100% - 56px), var(--max));
    margin: 0 auto;
  }

  .site-header {
    padding: 26px 0 18px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .wordmark {
    display: inline-flex;
    flex-direction: column;
    gap: 0;
    font-size: 11px;
    line-height: 1;
    font-weight: 750;
    letter-spacing: .09em;
  }

  .wordmark span:last-child {
    margin-top: 3px;
  }

  nav {
    display: flex;
    gap: 22px;
    font-size: 12px;
    line-height: 1;
  }

  nav a {
    color: var(--muted);
    transition: color .2s ease;
  }

  nav a:hover {
    color: var(--fg);
  }

  .site-footer {
    margin-top: 160px;
    padding: 28px 0 36px;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 30px 48px;
    align-items: start;
    font-size: 12px;
  }

  .site-footer > .footer-legal {
    grid-column: 1 / -1;
  }

  .site-footer > div {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .footer-muted,
  .site-footer a {
    color: var(--muted);
  }

  .footer-right {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .footer-legal {
    max-width: 560px;
    margin-top: 18px;
    color: var(--muted);
  }

  .footer-legal p {
    margin: 0;
    font-size: 10px;
    line-height: 1.55;
  }

  .site-footer a:hover {
    color: var(--fg);
  }

  @media (max-width: 680px) {
    .site-header,
    .site-footer {
      width: min(calc(100% - 28px), var(--max));
    }

    .site-header {
      padding: 18px 0 12px;
      align-items: center;
    }

    .wordmark {
      font-size: 10px;
      letter-spacing: .08em;
    }

    nav {
      gap: 13px;
      font-size: 11px;
    }

    nav a {
      padding: 8px 0;
    }

    .site-footer {
      margin-top: 96px;
      padding-bottom: 28px;
      display: block;
      font-size: 11px;
    }

    .site-footer > div {
      display: block;
    }

    .footer-muted {
      display: block;
      margin-top: 5px;
    }

    .footer-right {
      display: block;
      margin-top: 16px;
    }

    .footer-right a {
      display: block;
      overflow-wrap: anywhere;
    }

    .footer-legal {
      max-width: 100%;
      margin-top: 22px;
    }

    .footer-legal p {
      font-size: 9px;
      line-height: 1.55;
    }
  }
</style>
