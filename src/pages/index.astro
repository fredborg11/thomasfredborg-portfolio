---
import BaseLayout from "../layouts/BaseLayout.astro";

const modules = import.meta.glob("../content/cases/*.md", { eager: true });
const allCases = Object.values(modules).map((mod) => mod);
const cases = allCases
  .sort((a, b) => Number(b.frontmatter.year ?? 0) - Number(a.frontmatter.year ?? 0));

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const mediaUrl = (path) => path?.startsWith("/") ? `${base}${path.slice(1)}` : path;
---

<BaseLayout
  title="Thomas Fredborg — Graphic Designer / Art Director"
  description="Portfolio of Thomas Fredborg — graphic design, branding, retail, digital, packaging and motion."
>
  <section class="hero">
    <p class="eyebrow">Graphic Designer / Art Director</p>

    <h1>
      I make visual<br />
      identities <em>work.</em>
    </h1>

    <div class="hero-bottom">
      <p class="hero-copy">
        13+ years of experience across retail, branding, campaigns,
        digital, packaging, print and creative production.
      </p>

      <a class="scroll-link" href="#work">
        <span>Selected work</span>
        <span>↓</span>
      </a>
    </div>
  </section>

  <section id="work" class="work">
    <div class="section-head">
      <h2>Selected work</h2>
      <span>{cases.length.toString().padStart(2, "0")} projects</span>
    </div>

    <div class="grid">
      {cases.map((item, index) => {
        const cover = item.frontmatter.cover;
        const slug = item.file.split("/").pop()?.replace(/\.md$/, "");
        const featured = index === 0;
        return (
          <a class:list={["project", { featured }]} href={`${base}cases/${slug}/`}>
            <div class="project-media">
              {cover ? (
                <img src={mediaUrl(cover)} alt="" loading={index > 1 ? "lazy" : "eager"} />
              ) : (
                <div class="project-placeholder">
                  <span>{item.frontmatter.category ?? "Graphic Design"}</span>
                </div>
              )}
            </div>

            <div class="project-meta">
              <div class="project-name">
                <h3>{item.frontmatter.title}</h3>
                <p>{item.frontmatter.client}</p>
              </div>

              <div class="project-right">
                <span>{item.frontmatter.year}</span>
                <div class="project-tags">
                  {(item.frontmatter.tags ?? []).slice(0, 3).map((tag) => <span>{tag}</span>)}
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <section id="about" class="about">
    <p class="eyebrow">About</p>

    <div class="about-content">
      <h2>Design should look right. More importantly, it should <em>work right.</em></h2>

      <div class="about-grid">
        <p>
          I work across branding, campaigns, retail, print, digital design,
          packaging and motion — from first brief to final delivery.
        </p>
        <p>
          With 13+ years of experience, my approach is grounded in commercial
          design: clear ideas, strong visual systems and work that holds up
          across real formats, deadlines and customer touchpoints.
        </p>
      </div>

      <div class="capabilities">
        <div>
          <span class="capability-label">Core</span>
          <span>Branding · Campaigns · Retail · Print</span>
        </div>
        <div>
          <span class="capability-label">Also</span>
          <span>Packaging · Digital · UI · Motion</span>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="contact">
    <p class="eyebrow">Contact</p>
    <div class="contact-content">
      <h2>Have a project, opportunity or <em>good idea?</em></h2>
      <a class="contact-link" href="mailto:hello@thomasfredborg.dk">
        <span>hello@thomasfredborg.dk</span>
        <span>↗</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    width: min(calc(100% - 56px), var(--max));
    margin: 14vh auto 20vh;
  }

  .eyebrow {
    margin: 0 0 24px;
    font-size: 11px;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: var(--muted);
  }

  h1 {
    margin: 0;
    max-width: 1280px;
    font-size: clamp(62px, 9.2vw, 148px);
    line-height: .88;
    font-weight: 540;
    letter-spacing: -.065em;
  }

  h1 em,
  .about h2 em {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    letter-spacing: -.045em;
  }

  .hero-bottom {
    margin-top: 72px;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 40px;
  }

  .hero-copy {
    max-width: 440px;
    margin: 0 0 0 31%;
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
  }

  .scroll-link {
    display: inline-flex;
    gap: 20px;
    align-items: center;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--fg);
    font-size: 12px;
  }

  .work {
    width: min(calc(100% - 56px), var(--max));
    margin: 0 auto;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 15px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 26px;
  }

  .section-head h2 {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
  }

  .section-head span {
    font-size: 11px;
    color: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 72px 28px;
  }

  .project {
    display: block;
  }

  .project.featured {
    grid-column: span 2;
  }

  .project-media {
    overflow: hidden;
    background: var(--card);
    aspect-ratio: 4 / 3;
  }

  .project.featured .project-media {
    aspect-ratio: 16 / 9;
  }

  .project-media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform .65s cubic-bezier(.2,.7,.2,1);
  }

  .project:hover .project-media img {
    transform: scale(1.018);
  }

  .project-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    padding: 18px;
    color: #77756f;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .12em;
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-top: 13px;
  }

  .project-name h3,
  .project-name p {
    margin: 0;
  }

  .project-name h3 {
    font-size: 14px;
    font-weight: 600;
  }

  .project-name p {
    margin-top: 3px;
    font-size: 12px;
    color: var(--muted);
  }

  .project-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    font-size: 11px;
    color: var(--muted);
  }

  .project-tags {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .project-tags span {
    padding: 4px 7px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 9px;
    letter-spacing: .01em;
  }

  .about {
    width: min(calc(100% - 56px), var(--max));
    margin: 24vh auto 0;
    display: grid;
    grid-template-columns: .2fr .8fr;
    gap: 5vw;
  }

  .about-content h2 {
    margin: 0;
    max-width: 1050px;
    font-size: clamp(38px, 5.3vw, 76px);
    line-height: .96;
    font-weight: 500;
    letter-spacing: -.05em;
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6vw;
    max-width: 700px;
    margin-top: 52px;
  }

  .about-grid p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  .capabilities {
    margin-top: 76px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .capabilities > div {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 24px;
    padding: 15px 0;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
    line-height: 1.4;
  }

  .capabilities > div:last-child {
    border-bottom: 0;
  }

  .capability-label {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: .12em;
    font-size: 9px;
  }

  .contact {
    width: min(calc(100% - 56px), var(--max));
    margin: 24vh auto 0;
    display: grid;
    grid-template-columns: .2fr .8fr;
    gap: 5vw;
  }

  .contact-content h2 {
    margin: 0;
    max-width: 1050px;
    font-size: clamp(42px, 6vw, 88px);
    line-height: .95;
    font-weight: 500;
    letter-spacing: -.05em;
  }

  .contact-content h2 em {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    letter-spacing: -.045em;
  }

  .contact-link {
    margin-top: 70px;
    padding: 17px 0;
    border-top: 1px solid var(--fg);
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font-size: 13px;
    transition: opacity .2s ease;
  }

  .contact-link:hover {
    opacity: .55;
  }

  @media (max-width: 820px) {
    .hero,
    .work,
    .about {
      width: min(calc(100% - 28px), var(--max));
    }

    .hero {
      margin-top: 11vh;
      margin-bottom: 16vh;
    }

    .hero-copy {
      margin-left: 0;
    }

    .grid {
      gap: 48px 20px;
    }

    .about,
    .contact {
      grid-template-columns: 1fr;
      gap: 26px;
      margin-top: 18vh;
    }
  }

  @media (max-width: 680px) {
    .hero {
      margin-top: 10vh;
      margin-bottom: 14vh;
    }

    h1 {
      font-size: clamp(54px, 15vw, 88px);
    }

    .hero-bottom {
      display: block;
      margin-top: 42px;
    }

    .scroll-link {
      margin-top: 28px;
    }

    .grid {
      grid-template-columns: 1fr;
      gap: 42px;
    }

    .project.featured {
      grid-column: auto;
    }

    .project.featured .project-media {
      aspect-ratio: 4 / 3;
    }

    .project-meta {
      display: block;
    }

    .project-right {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      margin-top: 9px;
    }

    .project-tags {
      justify-content: flex-end;
    }

    .about-grid {
      grid-template-columns: 1fr;
      gap: 22px;
      margin-top: 34px;
    }

    .capabilities {
      margin-top: 48px;
    }

    .capabilities > div {
      grid-template-columns: 78px 1fr;
      gap: 16px;
      font-size: 12px;
    }

    .contact-content h2 {
      font-size: clamp(38px, 11vw, 64px);
    }

    .contact-link {
      margin-top: 44px;
    }
  }
</style>
