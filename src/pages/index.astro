---
import BaseLayout from "../layouts/BaseLayout.astro";

const modules = import.meta.glob("../../content/cases/*.md", { eager: true });
const allCases = Object.values(modules).map((mod) => mod);
const cases = allCases
  .sort((a, b) => Number(b.frontmatter.year ?? 0) - Number(a.frontmatter.year ?? 0));

const base = import.meta.env.BASE_URL;
const mediaUrl = (path) => path?.startsWith("/") ? `${base.replace(/\/$/, "")}${path}` : path;
---
<BaseLayout
  title="Thomas Fredborg — Graphic Designer / Art Director"
  description="Portfolio of Thomas Fredborg — graphic design, branding, retail, digital, packaging and motion."
>
  <section class="intro">
    <p class="eyebrow">Graphic Designer / Art Director</p>
    <h1>Design that makes<br />things <em>work.</em></h1>
    <p class="intro-copy">
      13+ years of experience across graphic design, retail, branding, digital,
      print and creative production.
    </p>
  </section>

  <section id="work" class="work">
    <div class="section-head">
      <h2>Selected work</h2>
      <span>{cases.length.toString().padStart(2, "0")} projects</span>
    </div>

    <div class="grid">
      {cases.map((item) => {
        const cover = item.frontmatter.cover;
        const slug = item.file.split("/").pop()?.replace(/\.md$/, "");
        return (
          <a class="project" href={`${base}cases/${slug}`}>
            <div class="project-media">
              {cover ? (
                <img src={mediaUrl(cover)} alt="" loading="lazy" />
              ) : (
                <div class="project-placeholder">
                  <span>{item.frontmatter.category ?? "Graphic Design"}</span>
                </div>
              )}
            </div>
            <div class="project-meta">
              <div>
                <h3>{item.frontmatter.title}</h3>
                <p>{item.frontmatter.client}</p>
              </div>
              <div class="project-tags">
                {(item.frontmatter.tags ?? []).slice(0, 3).map((tag) => <span>{tag}</span>)}
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <section id="about" class="about">
    <div>
      <p class="eyebrow">About</p>
      <h2>Visual design, retail and the discipline of making ideas real.</h2>
    </div>
    <p>
      I work across branding, campaigns, print, digital design, retail and
      motion — from the first brief to the final delivery. I enjoy the space
      between the creative idea and the practical details that make it work.
    </p>
  </section>
</BaseLayout>

<style>
  .intro {
    width: min(calc(100% - 40px), 1040px);
    margin: 15vh auto 20vh;
  }

  .eyebrow {
    margin: 0 0 22px;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: #6a6965;
  }

  h1 {
    margin: 0;
    font-size: clamp(56px, 10vw, 148px);
    line-height: .89;
    font-weight: 600;
    letter-spacing: -.055em;
    max-width: 1200px;
  }

  h1 em {
    font-family: Georgia, serif;
    font-weight: 400;
    letter-spacing: -.04em;
  }

  .intro-copy {
    max-width: 470px;
    margin: 44px 0 0 auto;
    font-size: 17px;
    line-height: 1.5;
    color: #55534f;
  }

  .work,
  .about {
    width: min(calc(100% - 40px), var(--max));
    margin: 0 auto;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 24px;
  }

  .section-head h2 {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
  }

  .section-head span {
    font-size: 12px;
    color: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 58px 28px;
  }

  .project {
    display: block;
  }

  .project:nth-child(3n) {
    grid-column: span 2;
  }

  .project-media {
    background: var(--card);
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .project:nth-child(3n) .project-media {
    aspect-ratio: 16 / 9;
  }

  .project-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .45s cubic-bezier(.2,.7,.2,1);
  }

  .project:hover img {
    transform: scale(1.02);
  }

  .project-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    padding: 18px;
    color: #67655f;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .1em;
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-top: 12px;
  }

  .project-meta h3,
  .project-meta p {
    margin: 0;
  }

  .project-meta h3 {
    font-size: 15px;
    font-weight: 600;
  }

  .project-meta p {
    margin-top: 3px;
    font-size: 13px;
    color: var(--muted);
  }

  .project-tags {
    display: flex;
    justify-content: flex-end;
    gap: 5px;
    flex-wrap: wrap;
    max-width: 45%;
  }

  .project-tags span {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 8px;
    font-size: 10px;
    color: var(--muted);
  }

  .about {
    margin-top: 22vh;
    display: grid;
    grid-template-columns: 1.3fr .7fr;
    gap: 10vw;
    align-items: start;
  }

  .about h2 {
    margin: 0;
    max-width: 780px;
    font-size: clamp(36px, 5.4vw, 78px);
    line-height: .98;
    letter-spacing: -.045em;
    font-weight: 500;
  }

  .about > p {
    margin: 42px 0 0;
    font-size: 16px;
    line-height: 1.55;
    color: #55534f;
  }

  @media (max-width: 820px) {
    .intro {
      margin-top: 12vh;
      margin-bottom: 16vh;
    }

    .grid {
      grid-template-columns: 1fr;
      gap: 42px;
    }

    .project:nth-child(3n) {
      grid-column: auto;
    }

    .project:nth-child(3n) .project-media {
      aspect-ratio: 4 / 3;
    }

    .about {
      grid-template-columns: 1fr;
      gap: 30px;
      margin-top: 18vh;
    }

    .about > p {
      margin-top: 0;
      max-width: 620px;
    }
  }

  @media (max-width: 680px) {
    .work,
    .about {
      width: min(calc(100% - 28px), var(--max));
    }

    .intro {
      width: min(calc(100% - 28px), 1040px);
    }

    .intro-copy {
      margin-left: 0;
    }

    .project-meta {
      display: block;
    }

    .project-tags {
      justify-content: flex-start;
      max-width: none;
      margin-top: 10px;
    }
  }
</style>
