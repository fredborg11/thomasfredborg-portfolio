---
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  const entries = import.meta.glob("../../content/cases/*.md", { eager: true });
  return Object.entries(entries).map(([file, entry]) => ({
    params: { slug: file.split("/").pop()?.replace(/\.md$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = entry;
const frontmatter = entry.frontmatter;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const mediaUrl = (path) => path?.startsWith("/") ? `${base}${path.slice(1)}` : path;
---

<BaseLayout
  title={`${frontmatter.title} — Thomas Fredborg`}
  description={frontmatter.intro ?? "Selected work by Thomas Fredborg."}
>
  <article class="case">
    <a class="back" href={base}>← All work</a>

    <header class="case-header">
      <div>
        <p class="eyebrow">{frontmatter.category ?? "Selected work"}</p>
        <h1>{frontmatter.title}</h1>
      </div>

      {frontmatter.intro && <p class="intro">{frontmatter.intro}</p>}
    </header>

    <div class="facts">
      {frontmatter.client && <div><span>Client</span><strong>{frontmatter.client}</strong></div>}
      {frontmatter.year && <div><span>Year</span><strong>{frontmatter.year}</strong></div>}
      {frontmatter.role && <div><span>Role</span><strong>{frontmatter.role}</strong></div>}
      {frontmatter.tags?.length && <div><span>Focus</span><strong>{frontmatter.tags.join(" · ")}</strong></div>}
    </div>

    {frontmatter.cover && (
      <figure class="hero-image">
        <img src={mediaUrl(frontmatter.cover)} alt="" />
      </figure>
    )}

    {frontmatter.gallery?.length && (
      <div class="gallery">
        {frontmatter.gallery.map((image, index) => (
          <figure class:list={[
              "gallery-item",
              {
                "gallery-wide": index === 0 || index === 3,
                "gallery-tall": index === 1
              }
            ]}>
            <img src={mediaUrl(image)} alt="" loading="lazy" />
          </figure>
        ))}
      </div>
    )}

    {frontmatter.video && (
      <div class="video-wrap">
        <video controls playsinline preload="metadata">
          <source src={mediaUrl(frontmatter.video)} />
        </video>
      </div>
    )}

    <div class="body">
      <Content />
    </div>

    <a class="next-case" href={base}>
      <span>Back to selected work</span>
      <span>↗</span>
    </a>
  </article>
</BaseLayout>

<style>
  .case {
    width: min(calc(100% - 56px), var(--max));
    margin: 56px auto 0;
  }

  .back {
    font-size: 12px;
    color: var(--muted);
    transition: color .2s ease;
  }

  .back:hover {
    color: var(--fg);
  }

  .case-header {
    margin: 15vh 0 10vh;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, .45fr);
    gap: 8vw;
    align-items: end;
  }

  .eyebrow {
    margin: 0 0 18px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: var(--muted);
  }

  .case-header h1 {
    margin: 0;
    max-width: 1100px;
    font-size: clamp(64px, 9.2vw, 148px);
    line-height: .86;
    letter-spacing: -.068em;
    font-weight: 540;
  }

  .intro {
    max-width: 470px;
    margin: 0 0 7px;
    font-size: 17px;
    line-height: 1.5;
    color: var(--muted);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: 28px;
  }

  .facts > div {
    min-width: 0;
    padding: 14px 18px 16px 0;
  }

  .facts span {
    display: block;
    margin-bottom: 7px;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--muted);
  }

  .facts strong {
    display: block;
    font-size: 12px;
    line-height: 1.4;
    font-weight: 500;
    max-width: 180px;
  }

  figure {
    margin: 0;
  }

  .hero-image {
    background: var(--card);
  }

  .hero-image img,
  .gallery img,
  .video-wrap video {
    width: 100%;
    display: block;
  }

  .hero-image img {
    max-height: 78vh;
    object-fit: cover;
  }

  .gallery {
    margin-top: 22px;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 22px;
  }

  .gallery-item {
    grid-column: span 6;
    background: var(--card);
    overflow: hidden;
  }

  .gallery-wide {
    grid-column: 1 / -1;
  }

  .gallery-tall {
    grid-column: span 5;
  }

  .gallery-item img {
    transition: transform .7s cubic-bezier(.2,.7,.2,1);
  }

  .gallery-item:hover img {
    transform: scale(1.012);
  }

  .video-wrap {
    margin-top: 22px;
    background: #171715;
  }

  .body {
    max-width: 820px;
    margin: 15vh auto 0;
    font-size: 16px;
    line-height: 1.72;
  }

  .body :global(h2) {
    margin: 2.8em 0 .8em;
    padding-top: 1.3em;
    border-top: 1px solid var(--line);
    font-size: 30px;
    line-height: 1.04;
    font-weight: 500;
    letter-spacing: -.035em;
  }

  .body :global(h2:first-child) {
    padding-top: 0;
    border-top: 0;
  }

  .body :global(p) {
    margin: 0 0 1.3em;
  }

  .body :global(ul) {
    list-style: none;
    margin: 1.4em 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 34px;
    border-top: 1px solid var(--line);
  }

  .body :global(li) {
    padding: 14px 0 15px;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
    line-height: 1.45;
  }

  .body :global(blockquote) {
    margin: 2.6em 0 3em;
    padding: 0;
    border: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(28px, 3.2vw, 46px);
    line-height: 1.03;
    letter-spacing: -.035em;
    color: var(--fg);
  }

  .body :global(blockquote p) {
    margin: 0 0 .5em;
  }

  .next-case {
    margin-top: 17vh;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    font-size: 12px;
  }

  .next-case span:first-child {
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .case {
      width: min(calc(100% - 28px), var(--max));
    }

    .case-header {
      grid-template-columns: 1fr;
      gap: 30px;
      margin-top: 12vh;
      margin-bottom: 10vh;
    }

    .facts {
      grid-template-columns: repeat(2, 1fr);
    }

    .body :global(ul) {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .case {
      margin-top: 34px;
    }

    .case-header h1 {
      font-size: clamp(54px, 15vw, 88px);
    }

    .gallery {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .gallery-item,
    .gallery-wide,
    .gallery-tall {
      grid-column: auto;
    }

    .body {
      margin-top: 12vh;
      font-size: 15px;
    }

    .body :global(h2) {
      font-size: 27px;
    }

    .body :global(blockquote) {
      font-size: 32px;
    }
  }
</style>
