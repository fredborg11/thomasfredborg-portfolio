---
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  const entries = import.meta.glob("../../content/cases/*.md", { eager: true });
  return Object.entries(entries).map(([file, entry]) => ({
    params: { slug: file.split("/").pop()?.replace(/\.md$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = entry;
const frontmatter = entry.frontmatter;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const mediaUrl = (path) => path?.startsWith("/") ? `${base}${path.slice(1)}` : path;
---

<BaseLayout
  title={`${frontmatter.title} — Thomas Fredborg`}
  description={frontmatter.intro ?? "Selected work by Thomas Fredborg."}
>
  <article class="case">
    <a class="back" href={base}>← All work</a>

    <header class="case-header">
      <div>
        <p class="eyebrow">{frontmatter.category ?? "Selected work"}</p>
        <h1>{frontmatter.title}</h1>
      </div>

      {frontmatter.intro && <p class="intro">{frontmatter.intro}</p>}
    </header>

    <div class="facts">
      {frontmatter.client && <div><span>Client</span><strong>{frontmatter.client}</strong></div>}
      {frontmatter.year && <div><span>Year</span><strong>{frontmatter.year}</strong></div>}
      {frontmatter.role && <div><span>Role</span><strong>{frontmatter.role}</strong></div>}
      {frontmatter.tags?.length && <div><span>Focus</span><strong>{frontmatter.tags.join(" · ")}</strong></div>}
    </div>

    {frontmatter.cover && (
      <figure class="hero-image">
        <img src={mediaUrl(frontmatter.cover)} alt="" />
      </figure>
    )}

    {frontmatter.gallery?.length && (
      <div class="gallery">
        {frontmatter.gallery.map((image, index) => (
          <figure class:list={["gallery-item", { "gallery-wide": index === 0 }]}>
            <img src={mediaUrl(image)} alt="" loading="lazy" />
          </figure>
        ))}
      </div>
    )}

    {frontmatter.video && (
      <div class="video-wrap">
        <video controls playsinline preload="metadata">
          <source src={mediaUrl(frontmatter.video)} />
        </video>
      </div>
    )}

    <div class="body">
      <Content />
    </div>

    <a class="next-case" href={base}>
      <span>Back to selected work</span>
      <span>↗</span>
    </a>
  </article>
</BaseLayout>

<style>
  .case {
    width: min(calc(100% - 56px), var(--max));
    margin: 56px auto 0;
  }

  .back {
    font-size: 12px;
    color: var(--muted);
  }

  .case-header {
    margin: 15vh 0 11vh;
    display: grid;
    grid-template-columns: 1fr .55fr;
    gap: 8vw;
    align-items: end;
  }

  .eyebrow {
    margin: 0 0 18px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: var(--muted);
  }

  .case-header h1 {
    margin: 0;
    font-size: clamp(64px, 9.4vw, 148px);
    line-height: .88;
    letter-spacing: -.065em;
    font-weight: 540;
  }

  .intro {
    max-width: 470px;
    margin: 0 0 7px;
    font-size: 17px;
    line-height: 1.5;
    color: var(--muted);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: 28px;
  }

  .facts > div {
    padding: 13px 18px 15px 0;
  }

  .facts span {
    display: block;
    margin-bottom: 6px;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--muted);
  }

  .facts strong {
    display: block;
    font-size: 12px;
    line-height: 1.35;
    font-weight: 500;
  }

  figure {
    margin: 0;
  }

  .hero-image {
    background: var(--card);
  }

  .hero-image img,
  .gallery img,
  .video-wrap video {
    width: 100%;
    display: block;
  }

  .gallery {
    margin-top: 22px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
  }

  .gallery-item {
    background: var(--card);
  }

  .gallery-wide {
    grid-column: span 2;
  }

  .video-wrap {
    margin-top: 22px;
    background: #171715;
  }

  .body {
    max-width: 760px;
    margin: 16vh auto 0;
    font-size: 16px;
    line-height: 1.7;
  }

  .body :global(h2) {
    margin: 2.8em 0 .8em;
    font-size: 30px;
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: -.035em;
  }

  .body :global(p) {
    margin: 0 0 1.25em;
  }

  .body :global(ul) {
    padding-left: 1.2em;
  }

  .next-case {
    margin-top: 17vh;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    font-size: 12px;
  }

  .next-case span:first-child {
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .case {
      width: min(calc(100% - 28px), var(--max));
    }

    .case-header {
      grid-template-columns: 1fr;
      gap: 30px;
      margin-top: 12vh;
      margin-bottom: 10vh;
    }

    .facts {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 680px) {
    .case {
      margin-top: 34px;
    }

    .case-header h1 {
      font-size: clamp(54px, 15vw, 88px);
    }

    .gallery {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .gallery-wide {
      grid-column: auto;
    }

    .body {
      margin-top: 12vh;
      font-size: 15px;
    }
  }
</style>
