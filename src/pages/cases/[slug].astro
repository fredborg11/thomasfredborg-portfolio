---
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  const entries = import.meta.glob("../../content/cases/*.md", { eager: true });
  return Object.entries(entries).map(([file, entry]) => ({
    params: { slug: file.split("/").pop()?.replace(/\.md$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = entry;
const frontmatter = entry.frontmatter;
const isLoyaltyApp = frontmatter.slug === "pisiffik-loyalty-app";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const mediaUrl = (path) => path?.startsWith("/") ? `${base}${path.slice(1)}` : path;
---

<BaseLayout
  title={`${frontmatter.title} — Thomas Fredborg`}
  description={frontmatter.intro ?? "Selected work by Thomas Fredborg."}
  image={frontmatter.cover ?? ""}
>
  <article class="case">
    <a class="back" href={base}>← All work</a>

    <header class="case-header">
      <div>
        <p class="eyebrow">{frontmatter.category ?? "Selected work"}</p>
        <h1>{frontmatter.title}</h1>
      </div>

      {frontmatter.intro && <p class="intro">{frontmatter.intro}</p>}
    </header>

    <div class="facts">
      {frontmatter.client && <div><span>Client</span><strong>{frontmatter.client}</strong></div>}
      {frontmatter.year && <div><span>Year</span><strong>{frontmatter.year}</strong></div>}
      {frontmatter.role && <div><span>Role</span><strong>{frontmatter.role}</strong></div>}
      {frontmatter.tags?.length && <div><span>Focus</span><strong>{frontmatter.tags.join(" · ")}</strong></div>}
    </div>

    <section class="mobile-details" aria-label="Case information">
      {frontmatter.intro && (
        <details class="mobile-detail">
          <summary>Description</summary>
          <div class="mobile-detail-content">
            <p>{frontmatter.intro}</p>
          </div>
        </details>
      )}
      <div class="mobile-body">
        <Content />
      </div>
    </section>

    {frontmatter.cover && (
      <figure class="hero-image">
        <img src={mediaUrl(frontmatter.cover)} alt="" />
      </figure>
    )}

    {isLoyaltyApp ? (
      <div class="loyalty-media">
        {frontmatter.gallery?.length >= 3 && (
          <section class="media-section">
            <div class="media-kicker">01 / Digital experience</div>
            <div class="gallery loyalty-gallery loyalty-gallery-digital">
              {frontmatter.gallery.slice(0, 3).map((image, index) => (
                <figure class={`gallery-item gallery-item-${index}`}>
                  <img src={mediaUrl(image)} alt="" loading="lazy" />
                </figure>
              ))}
            </div>
          </section>
        )}

        {frontmatter.video && (
          <section class="media-section launch-animation">
            <div class="media-kicker">02 / Motion</div>
            <div class="video-stage">
              <video controls playsinline preload="metadata">
                <source src={mediaUrl(frontmatter.video)} />
              </video>
            </div>
          </section>
        )}

        {frontmatter.gallery?.length > 3 && (
          <section class="media-section">
            <div class="media-kicker">03 / Physical retail</div>
            <div class="gallery loyalty-gallery loyalty-gallery-physical">
              {frontmatter.gallery.slice(3).map((image, index) => (
                <figure class={`gallery-item gallery-item-${index + 3}`}>
                  <img src={mediaUrl(image)} alt="" loading="lazy" />
                </figure>
              ))}
            </div>
          </section>
        )}
      </div>
    ) : (
      <>
        {frontmatter.gallery?.length && (
          <div class:list={["gallery", { "gallery-seven": frontmatter.gallery?.length === 7 }]} >
            {frontmatter.gallery.map((image, index) => (
              <figure class={`gallery-item gallery-item-${index}`}>
                <img src={mediaUrl(image)} alt="" loading="lazy" />
              </figure>
            ))}
          </div>
        )}

        {frontmatter.video && (
          <div class="video-wrap">
            <video controls playsinline preload="metadata">
              <source src={mediaUrl(frontmatter.video)} />
            </video>
          </div>
        )}
      </>
    )}

    <div class="body">
      <Content />
    </div>

    <a class="next-case" href={base}>
      <span>Back to selected work</span>
      <span>↗</span>
    </a>
  </article>

<script>
  (() => {
    const enhanceMobileCase = () => {
      document.querySelectorAll(".mobile-body").forEach((mobileBody) => {
        if (mobileBody.dataset.processed === "true") return;

        const nodes = Array.from(mobileBody.children);
        if (!nodes.length) return;

        mobileBody.innerHTML = "";

        let currentDetail = null;

        for (const node of nodes) {
          if (node.tagName === "H2") {
            currentDetail = document.createElement("details");
            currentDetail.className = "mobile-detail";

            const summary = document.createElement("summary");
            summary.textContent = node.textContent?.trim() || "Details";

            const content = document.createElement("div");
            content.className = "mobile-detail-content";

            currentDetail.append(summary, content);
            mobileBody.appendChild(currentDetail);
          } else if (currentDetail) {
            currentDetail.querySelector(".mobile-detail-content")?.appendChild(node);
          }
        }

        mobileBody.dataset.processed = "true";
        mobileBody.classList.add("is-enhanced");
      });
    };

    enhanceMobileCase();
    document.addEventListener("astro:page-load", enhanceMobileCase);
  })();
</script>

</BaseLayout>

<style>
  .case {
    width: min(calc(100% - 56px), var(--max));
    margin: 56px auto 0;
  }

  .back {
    font-size: 12px;
    color: var(--muted);
    transition: color .2s ease;
  }

  .back:hover {
    color: var(--fg);
  }

  .case-header {
    margin: 15vh 0 10vh;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, .45fr);
    gap: 8vw;
    align-items: end;
  }

  .eyebrow {
    margin: 0 0 18px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: var(--muted);
  }

  .case-header h1 {
    margin: 0;
    max-width: 1100px;
    font-size: clamp(64px, 9.2vw, 148px);
    line-height: .86;
    letter-spacing: -.068em;
    font-weight: 540;
  }

  .intro {
    max-width: 470px;
    margin: 0 0 7px;
    font-size: 17px;
    line-height: 1.5;
    color: var(--muted);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: 28px;
  }

  .facts > div {
    min-width: 0;
    padding: 14px 18px 16px 0;
  }

  .facts span {
    display: block;
    margin-bottom: 7px;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--muted);
  }

  .facts strong {
    display: block;
    font-size: 12px;
    line-height: 1.4;
    font-weight: 500;
    max-width: 180px;
  }

  figure {
    margin: 0;
  }

  .hero-image {
    background: var(--card);
  }

  .hero-image img,
  .gallery img,
  .video-wrap video {
    width: 100%;
    display: block;
  }

  .hero-image img {
    max-height: 78vh;
    object-fit: cover;
  }

  .gallery {
    margin-top: 22px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .gallery-item {
    grid-column: span 1;
    aspect-ratio: 4 / 3;
    background: var(--card);
    overflow: hidden;
  }

  .gallery-item-2,
  .gallery-item-3 {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }

  /* Pinetree: create a deliberate 1 + 2 + 2 + 1 + 1 rhythm
     for the seven gallery images. */
  .gallery-seven .gallery-item {
    grid-column: span 1;
    aspect-ratio: 4 / 3;
  }

  .gallery-seven .gallery-item-0,
  .gallery-seven .gallery-item-5,
  .gallery-seven .gallery-item-6 {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .7s cubic-bezier(.2,.7,.2,1);
  }

  .gallery-item:hover img {
    transform: scale(1.012);
  }

  .loyalty-media {
    display: grid;
    gap: clamp(70px, 10vw, 150px);
  }

  .media-section {
    display: grid;
    gap: 14px;
  }

  .media-kicker {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: var(--muted);
  }

  .loyalty-gallery {
    margin-top: 0;
  }

  .loyalty-gallery-digital .gallery-item-0,
  .loyalty-gallery-digital .gallery-item-1 {
    grid-column: span 1;
    aspect-ratio: 4 / 3;
  }

  .loyalty-gallery-digital .gallery-item-2 {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }

  .loyalty-gallery-physical .gallery-item {
    grid-column: span 1;
    aspect-ratio: 4 / 3;
  }

  .video-stage {
    min-height: min(76vh, 860px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(28px, 5vw, 70px);
    background: var(--card);
    overflow: hidden;
  }

  .video-stage video {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 74vh;
    height: auto;
  }

  .video-wrap {
    margin-top: 22px;
    background: #171715;
  }

  .mobile-details {
    display: none;
  }

  .body {
    max-width: 820px;
    margin: 15vh auto 0;
    font-size: 16px;
    line-height: 1.72;
  }

  .body :global(h2) {
    margin: 2.8em 0 .8em;
    padding-top: 1.3em;
    border-top: 1px solid var(--line);
    font-size: 30px;
    line-height: 1.04;
    font-weight: 500;
    letter-spacing: -.035em;
  }

  .body :global(h2:first-child) {
    padding-top: 0;
    border-top: 0;
  }

  .body :global(p) {
    margin: 0 0 1.3em;
  }

  .body :global(ul) {
    list-style: none;
    margin: 1.4em 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 34px;
    border-top: 1px solid var(--line);
  }

  .body :global(li) {
    padding: 14px 0 15px;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
    line-height: 1.45;
  }

  .body :global(blockquote) {
    margin: 2.6em 0 3em;
    padding: 0;
    border: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(28px, 3.2vw, 46px);
    line-height: 1.03;
    letter-spacing: -.035em;
    color: var(--fg);
  }

  .body :global(blockquote p) {
    margin: 0 0 .5em;
  }

  .next-case {
    margin-top: 17vh;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    font-size: 12px;
  }

  .next-case span:first-child {
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .case {
      width: min(calc(100% - 28px), var(--max));
    }

    .case-header {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-top: 9vh;
      margin-bottom: 8vh;
    }

    .case-header h1 {
      font-size: clamp(58px, 12vw, 100px);
    }

    .intro {
      max-width: 520px;
      font-size: 16px;
    }

    .facts {
      grid-template-columns: repeat(2, 1fr);
      margin-bottom: 18px;
    }

    .facts > div {
      padding: 12px 14px 13px 0;
    }

    .facts strong {
      max-width: none;
    }

    .body :global(ul) {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .case {
      margin-top: 24px;
    }

    .back {
      display: inline-block;
      padding: 8px 0;
    }

    .case-header {
      gap: 22px;
      margin-top: 8vh;
      margin-bottom: 7vh;
    }

    .case-header h1 {
      font-size: clamp(50px, 14.5vw, 82px);
      line-height: .88;
    }

    .intro {
      display: none;
    }

    .facts {
      margin-bottom: 16px;
    }

    .facts span {
      font-size: 8px;
    }

    .facts strong {
      font-size: 11px;
      line-height: 1.35;
    }

    .mobile-details {
      display: block;
      margin-bottom: 18px;
      border-top: 1px solid var(--line);
    }

    :global(.mobile-detail) {
      border-bottom: 1px solid var(--line);
    }

    :global(.mobile-detail > summary) {
      list-style: none;
      cursor: pointer;
      padding: 15px 0 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 14px;
      line-height: 1.35;
      font-weight: 500;
    }

    :global(.mobile-detail > summary::-webkit-details-marker) {
      display: none;
    }

    :global(.mobile-detail > summary::after) {
      content: "+";
      font-size: 16px;
      line-height: 1;
      color: var(--muted);
      transition: transform .2s ease;
    }

    :global(.mobile-detail[open] > summary::after) {
      content: "−";
    }

    :global(.mobile-detail-content) {
      padding: 0 0 17px;
      font-size: 14px;
      line-height: 1.58;
      color: var(--muted);
    }

    :global(.mobile-detail-content p) {
      margin: 0;
    }

    .mobile-body {
      font-size: 14px;
      line-height: 1.58;
    }

    .mobile-body.is-enhanced {
      display: grid;
    }

    :global(.mobile-body .mobile-detail) {
      display: block;
    }

    .mobile-body .mobile-detail-content :global(h2),
    .mobile-body .mobile-detail-content :global(p),
    .mobile-body .mobile-detail-content :global(ul),
    .mobile-body .mobile-detail-content :global(blockquote) {
      margin-top: 0;
    }

    .mobile-body .mobile-detail-content :global(p) {
      margin-bottom: 1.1em;
    }

    .mobile-body .mobile-detail-content :global(ul) {
      grid-template-columns: 1fr;
      margin-top: .8em;
    }

    .mobile-body .mobile-detail-content :global(li) {
      font-size: 13px;
      padding: 11px 0 12px;
    }

    .mobile-body .mobile-detail-content :global(blockquote) {
      font-size: 28px;
      margin: .4em 0 1em;
    }

    .body {
      display: none;
    }

    .hero-image img {
      max-height: none;
    }

    .loyalty-media {
      gap: 58px;
    }

    .media-section {
      gap: 10px;
    }

    .media-kicker {
      font-size: 9px;
    }

    .loyalty-gallery {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .loyalty-gallery-digital .gallery-item-0,
    .loyalty-gallery-digital .gallery-item-1,
    .loyalty-gallery-digital .gallery-item-2,
    .loyalty-gallery-physical .gallery-item {
      grid-column: 1 / -1;
      aspect-ratio: 4 / 3;
    }

    .video-stage {
      min-height: auto;
      padding: 18px;
    }

    .video-stage video {
      max-height: 76vh;
    }

    .gallery {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .gallery-item,
    .gallery-item-2,
    .gallery-item-3,
    .gallery-seven .gallery-item,
    .gallery-seven .gallery-item-0,
    .gallery-seven .gallery-item-5,
    .gallery-seven .gallery-item-6 {
      grid-column: 1 / -1;
      aspect-ratio: 4 / 3;
    }

    .body {
      margin-top: 10vh;
      font-size: 15px;
      line-height: 1.65;
    }

    .body :global(h2) {
      font-size: 27px;
      margin-top: 2.5em;
    }

    .body :global(blockquote) {
      font-size: 32px;
      margin-top: 2em;
    }

    .next-case {
      margin-top: 12vh;
    }
  }
</style>
