      margin-top: 7vh;
      margin-bottom: 11vh;
    }

    .eyebrow {
      margin-bottom: 18px;
      font-size: 10px;
    }

    h1 {
      font-size: clamp(48px, 14.5vw, 76px);
      line-height: .9;
      letter-spacing: -.068em;
    }

    .hero-bottom {
      display: block;
      margin-top: 30px;
    }

    .hero-copy {
      max-width: 390px;
      font-size: 14px;
      line-height: 1.55;
    }

    .hero-capabilities {
      margin-top: 18px;
      font-size: 8px;
      letter-spacing: .1em;
      white-space: normal;
    }

    .hero-capabilities span {
      margin: 0 5px;
    }

    .scroll-link {
      margin-top: 24px;
      min-height: 42px;
    }

    .section-head {
      margin-bottom: 18px;
      padding-bottom: 12px;
    }

    .grid {
      grid-template-columns: 1fr;
      gap: 38px;
    }

    .project.featured {
      grid-column: auto;
    }

    .project.featured .project-media,
    .project-media {
      aspect-ratio: 4 / 3;
    }

    .project-meta {
      display: block;
      padding-top: 11px;
    }

    .project-name h3 {
      font-size: 13px;
    }

    .project-name p {
      font-size: 11px;
    }

    .project-right {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      margin-top: 10px;
      gap: 14px;
    }

    .project-tags {
