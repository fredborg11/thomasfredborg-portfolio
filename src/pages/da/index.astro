      margin-bottom: 13vh;
    }

    .hero-intro {
      margin-left: 0;
      max-width: 620px;
    }

    .hero-copy {
      max-width: 480px;
    }

    .grid {
      gap: 48px 20px;
    }

    .about,
    .contact {
      grid-template-columns: 1fr;
      gap: 26px;
      margin-top: 16vh;
    }
  }

  @media (max-width: 680px) {
    .value-proposition,
    .experience-strip {
      width: min(calc(100% - 28px), var(--max));
    }

    .value-proposition {
      grid-template-columns: 1fr;
      gap: 28px;
      margin-top: 13vh;
    }

    .value-item {
      grid-template-columns: 28px minmax(0, 1fr);
      gap: 14px;
      padding: 18px 0;
    }

    .value-item h3 {
      font-size: 14px;
    }

    .value-item p {
      font-size: 13px;
    }

    .experience-strip {
      margin-top: 12vh;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .experience-stat,
    .experience-stat + .experience-stat {
      padding: 18px 12px 20px 0;
    }

    .experience-stat:nth-child(2n) {
      border-right: 0;
      padding-left: 12px;
    }

    .experience-stat:nth-child(-n+2) {
      border-bottom: 1px solid var(--line);
    }

    .experience-stat strong {
      font-size: 48px;
    }

    .experience-stat span {
      margin-top: 9px;
      font-size: 8px;
    }


