    margin: 0 0 7px;
    font-size: 16px;
    line-height: 1.2;
    font-weight: 600;
  }

  .value-item p {
    margin: 0;
    max-width: 640px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted);
  }

  .experience-strip {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .experience-stat {
    padding: 24px 20px 26px 0;
    border-right: 1px solid var(--line);
  }

  .experience-stat + .experience-stat {
    padding-left: 20px;
  }

  .experience-stat:last-child {
    border-right: 0;
  }

  .experience-stat strong {
    display: block;
    font-size: clamp(42px, 5vw, 72px);
    line-height: .9;
    font-weight: 500;
    letter-spacing: -.055em;
  }

  .experience-stat span {
    display: block;
    margin-top: 13px;
    max-width: 180px;
    font-size: 10px;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--muted);
  }

  .hero {
    width: min(calc(100% - 56px), var(--max));
    margin: 14vh auto 20vh;
  }

  .eyebrow {
    margin: 0 0 24px;
    font-size: 11px;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: var(--muted);
  }

  h1 {
    margin: 0;
    max-width: 1280px;
    font-size: clamp(62px, 9.2vw, 148px);
    line-height: .88;
    font-weight: 540;
    letter-spacing: -.065em;
  }

  h1 em,
  .about h2 em {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    letter-spacing: -.045em;
  }

  .hero-bottom {
    margin-top: 72px;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 40px;
  }

  .hero-intro {
    max-width: 620px;
    margin-left: 31%;
  }

  .hero-copy {
    max-width: 440px;
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
  }

  .hero-capabilities {
    margin: 24px 0 0;
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: .13em;
    color: var(--muted);
    white-space: nowrap;
  }

  .hero-capabilities span {
    margin: 0 7px;
    color: var(--line);
  }

  .scroll-link {
    display: inline-flex;
    gap: 20px;
    align-items: center;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--fg);
    font-size: 12px;
  }

  .work {
    width: min(calc(100% - 56px), var(--max));
    margin: 0 auto;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 15px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 26px;
  }

  .section-head h2 {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
  }

  .section-head span {
    font-size: 11px;
    color: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 72px 28px;
  }

  .project {
    display: block;
  }

  .project.featured {
    grid-column: span 2;
  }

  .project-media {
    overflow: hidden;
    background: var(--card);
    aspect-ratio: 4 / 3;
  }

  .project.featured .project-media {
    aspect-ratio: 16 / 9;
  }

  .project-media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform .65s cubic-bezier(.2,.7,.2,1);
  }

  .project:hover .project-media img {
    transform: scale(1.018);
  }

  .project-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    padding: 18px;
    color: #77756f;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .12em;
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-top: 13px;
  }

  .project-name h3,
  .project-name p {
    margin: 0;
  }

  .project-name h3 {
    font-size: 14px;
    font-weight: 600;
  }

  .project-name p {
    margin-top: 3px;
    font-size: 12px;
    color: var(--muted);
  }

  .project-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    font-size: 11px;
    color: var(--muted);
  }

  .project-tags {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .project-tags span {
    padding: 4px 7px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 9px;
    letter-spacing: .01em;
  }

  .about {
    width: min(calc(100% - 56px), var(--max));
    margin: 24vh auto 0;
    display: grid;
    grid-template-columns: .2fr .8fr;
    gap: 5vw;
  }

  .about-content {
    display: grid;
