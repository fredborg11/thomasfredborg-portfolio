---
import BaseLayout from "../../layouts/BaseLayout.astro";

const modules = import.meta.glob("../../content/cases-da/*.md", { eager: true });
const allCases = Object.values(modules).map((mod) => mod);
const caseOrder = [
  "pisiffik-loyalty-app",
  "flid",
  "simple-life-trope",
  "pisiffik-alkoholfri",
  "pisiffik-nonfood",
  "fair-fitness",
  "pinetree-golf",
];

const cases = allCases.sort((a, b) => {
  const aSlug = a.file.split("/").pop()?.replace(/\.md$/, "");
  const bSlug = b.file.split("/").pop()?.replace(/\.md$/, "");
  const aOrder = caseOrder.indexOf(aSlug);
  const bOrder = caseOrder.indexOf(bSlug);

  if (aOrder !== -1 || bOrder !== -1) {
    if (aOrder === -1) return 1;
    if (bOrder === -1) return -1;
    return aOrder - bOrder;
  }

  return Number(b.frontmatter.year ?? 0) - Number(a.frontmatter.year ?? 0);
});

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const mediaUrl = (path) => path?.startsWith("/") ? `${base}${path.slice(1)}` : path;
---

<BaseLayout
  lang="da"
  title="Senior Art Director & Grafisk Designer i København | Thomas Fredborg"
  description="Grafisk designer og art director i København og på Sjælland med fokus på branding, emballage, retail, kampagner, print, digitalt design og UI."
  image={cases[0]?.frontmatter.cover ?? ""}
  imageAlt={cases[0] ? `${cases[0].frontmatter.title} — Thomas Fredborg portfolio case` : "Thomas Fredborg — Senior Art Director & Grafisk Designer"}
>
  <section class="hero">
    <p class="eyebrow">Senior Art Director & Grafisk Designer · København / Sjælland</p>

    <h1>
      Jeg får visuelle<br />
      identiteter til at <em>fungere.</em>
    </h1>

    <div class="hero-bottom">
      <div class="hero-intro">
        <p class="hero-copy">
          13+ års erfaring med retail, branding, kampagner,
          digitalt design, emballage, print og kreativ produktion.
        </p>

        <p class="hero-capabilities" aria-label="Centrale designområder">
          BRANDING <span>·</span> DIGITALT <span>·</span> RETAIL <span>·</span> EMBALLAGE <span>·</span> PRINT <span>·</span> UI
        </p>
      </div>

      <a class="scroll-link" href="#work">
        <span>Udvalgte cases</span>
        <span>↓</span>
      </a>
    </div>
  </section>

  <section class="value-proposition">
    <div class="value-heading">
      <p class="eyebrow">Det jeg bidrager med</p>
      <h2>Design, der forbinder <em>tænkning og eksekvering.</em></h2>
    </div>
    <div class="value-grid">
      <div class="value-item"><span class="value-number">01</span><div><h3>Jeg gør kompleksitet enkel</h3><p>Jeg omsætter komplekse briefs, store mængder information og mange krav til klare visuelle systemer.</p></div></div>
      <div class="value-item"><span class="value-number">02</span><div><h3>Fra idé til produktion</h3><p>Jeg arbejder fra visuel retning og designudvikling til artwork, koordinering, produktion og levering.</p></div></div>
      <div class="value-item"><span class="value-number">03</span><div><h3>Design, der fungerer i virkeligheden</h3><p>Jeg designer til de formater, kanaler, mennesker og arbejdsgange, løsningen skal fungere i uden for mockuppet.</p></div></div>
    </div>
  </section>

  <section id="work" class="work">
    <div class="section-head">
      <h2>Udvalgte cases</h2>
      <span>{cases.length.toString().padStart(2, "0")} projekter</span>
    </div>

    <div class="grid">
      {cases.map((item, index) => {
        const cover = item.frontmatter.cover;
        const slug = item.file.split("/").pop()?.replace(/\.md$/, "");
        const featured = index === 0;
        return (
          <a class:list={["project", { featured }]} href={`${base}da/cases/${slug}/`}>
            <div class="project-media">
              {cover ? (
                <img
                  src={mediaUrl(cover)}
                  alt={`${item.frontmatter.title} — ${item.frontmatter.client ?? "udvalgt arbejde"}`}
                  loading={index > 1 ? "lazy" : "eager"}
                  decoding="async"
                />
              ) : (
                <div class="project-placeholder">
                  <span>{item.frontmatter.category ?? "Grafisk design"}</span>
                </div>
              )}
            </div>

            <div class="project-meta">
              <div class="project-name">
                <h3>{item.frontmatter.title}</h3>
                <p>{item.frontmatter.client}</p>
              </div>

              <div class="project-right">
                <span>{item.frontmatter.year}</span>
                <div class="project-tags">
                  {(item.frontmatter.tags ?? []).slice(0, 3).map((tag) => <span>{tag}</span>)}
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>


  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "CollectionPage",
        "@id": `${Astro.url}#webpage`,
        url: Astro.url,
        name: "Thomas Fredborg — Grafisk Designer & Art Director | København",
        description: "Portfolio med arbejde af Thomas Fredborg, grafisk designer og art director med fokus på branding, emballage, retail, digitalt design, print og UI.",
        isPartOf: { "@id": `${Astro.site?.toString() ?? "https://thomasfredborg.dk/"}#website` },
        mainEntity: { "@id": `${Astro.url}#work` }
      },
      {
        "@type": "ItemList",
        "@id": `${Astro.url}#work`,
        name: "Udvalgte cases",
        itemListElement: cases.map((item, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: item.frontmatter.title,
          url: new URL(`${base}da/cases/${item.file.split("/").pop()?.replace(/\.md$/, "")}/`, Astro.site).toString()
        }))
      }
    ]
  })}></script>
  <section class="experience-strip">
    <div class="experience-stat"><strong>13+</strong><span>års erfaring med design</span></div>
    <div class="experience-stat"><strong>18</strong><span>Fair Fitness-centre</span></div>
    <div class="experience-stat"><strong>7</strong><span>Pisiffik-butikker</span></div>
    <div class="experience-stat"><strong>56</strong><span>sider pr. FLID-nummer</span></div>
  </section>

  <section id="about" class="about">
    <p class="eyebrow">Om mig</p>

    <div class="about-content">
      <div class="about-profile">
        <figure class="about-portrait">
          <img
            src={mediaUrl("/media/Afslappet portræt i kreativt atelier.png")}
            alt="Thomas Fredborg — Grafisk Designer og Art Director"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <p class="about-caption">Thomas Fredborg · Grafisk Designer / Art Director</p>
      </div>

      <div class="about-copy">
        <h2>Design skal se rigtigt ud. Endnu vigtigere er det, at det <em>fungerer.</em></h2>

        <div class="about-grid">
          <p>
            Jeg er grafisk designer og art director med 13+ års erfaring inden for
            visuel identitet, retail, emballage, editorial, kampagner, print,
            digitalt design og UI. Jeg trives med arbejde, hvor kreative idéer
            og praktisk eksekvering skal fungere sammen.
          </p>
          <p>
            Min styrke er at omsætte komplekse briefs og store mængder information
            til klare visuelle systemer, der fungerer i virkeligheden. Jeg er vant til
            at tage ansvar for projekter fra første brief og designudvikling til artwork,
            produktion og levering, samtidig med at jeg arbejder direkte med kunder og
            koordinerer de praktiske detaljer undervejs.
          </p>
        </div>

        <div class="capabilities">
          <div>
            <span class="capability-label">Kerne</span>
            <span>Visuel identitet · Retail · Emballage · Print</span>
          </div>
          <div>
            <span class="capability-label">Digitalt</span>
            <span>UI · Digitalt design · Kampagner · Editorial</span>
          </div>
          <div>
            <span class="capability-label">Produktion</span>
            <span>Layout · Artwork · Kundekoordinering · Miljøgrafik</span>
          </div>
          <div>
            <span class="capability-label">Base</span>
            <span>København · Sjælland · Danmark</span>
          </div>
        </div>

        <a class="cv-download" href="/cv.pdf" download>
          <span>Download CV</span>
          <span>↗</span>
        </a>
      </div>
    </div>
  </section>

  <section id="contact" class="contact">
    <p class="eyebrow">Kontakt</p>
    <div class="contact-content">
      <h2>Har du et projekt, en mulighed eller en <em>god idé?</em></h2>
      <div class="contact-links">
        <a class="contact-link" href="mailto:fredborg11@gmail.com">
          <span>fredborg11@gmail.com</span>
          <span>↗</span>
        </a>
        <a class="contact-link" href="tel:+4528108213">
          <span>+45 28 10 82 13</span>
          <span>↗</span>
        </a>
        <a class="contact-link" href="https://www.linkedin.com/in/tfn/" target="_blank" rel="noopener noreferrer">
          <span>LinkedIn</span>
          <span>↗</span>
        </a>
      </div>

      <p class="contact-note">
        Åben for udvalgte freelanceprojekter, samarbejder og kreative muligheder.
        <br />
        Har du en forespørgsel, kan du kontakte mig via mail, telefon eller LinkedIn.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .value-proposition,
  .experience-strip {
    width: min(calc(100% - 56px), var(--max));
    margin: 18vh auto 0;
  }

  .value-proposition {
    display: grid;
    grid-template-columns: .28fr .72fr;
    gap: 5vw;
  }

  .value-heading h2 {
    margin: 0;
    max-width: 620px;
    font-size: clamp(38px, 5vw, 72px);
    line-height: .96;
    font-weight: 500;
    letter-spacing: -.05em;
  }

  .value-heading h2 em {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    letter-spacing: -.045em;
  }

  .value-grid {
    border-top: 1px solid var(--line);
  }

  .value-item {
