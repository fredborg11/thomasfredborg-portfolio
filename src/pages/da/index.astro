    gap: clamp(36px, 5vw, 84px);
    align-items: start;
  }

  .about-profile {
    min-width: 0;
    padding-top: 8px;
  }

  .about-portrait {
    width: 178px;
    height: 178px;
    margin: 0;
    border-radius: 50%;
    background: var(--card);
    overflow: hidden;
  }

  .about-portrait img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: 50% 35%;
  }

  .about-caption {
    margin: 10px 0 0;
    font-size: 10px;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: .11em;
    color: var(--muted);
  }

  .about-copy {
    min-width: 0;
  }

  .about-copy h2 {
    margin: 0;
    max-width: 1050px;
    font-size: clamp(38px, 5.3vw, 76px);
    line-height: .96;
    font-weight: 500;
    letter-spacing: -.05em;
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6vw;
    max-width: 700px;
    margin-top: 52px;
  }

  .about-grid p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  .capabilities {
    margin-top: 76px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .capabilities > div {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 24px;
    padding: 15px 0;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
    line-height: 1.4;
  }

  .capabilities > div:last-child {
    border-bottom: 0;
  }

  .cv-download {
    margin-top: 26px;
    width: fit-content;
    display: inline-flex;
    align-items: center;
    gap: 28px;
    padding: 13px 16px;
    border: 1px solid var(--fg);
    font-size: 11px;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: .09em;
    transition: background .2s ease, color .2s ease, opacity .2s ease;
  }

  .cv-download:hover {
    background: var(--fg);
    color: var(--bg);
  }

  .capability-label {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: .12em;
    font-size: 9px;
  }

  .contact {
    width: min(calc(100% - 56px), var(--max));
    margin: 24vh auto 0;
    display: grid;
    grid-template-columns: .2fr .8fr;
    gap: 5vw;
  }

  .contact-content h2 {
    margin: 0;
    max-width: 1050px;
    font-size: clamp(42px, 6vw, 88px);
    line-height: .95;
    font-weight: 500;
    letter-spacing: -.05em;
  }

  .contact-content h2 em {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    letter-spacing: -.045em;
  }

  .contact-links {
    margin-top: 70px;
  }

  .contact-link {
    padding: 17px 0;
    border-top: 1px solid var(--fg);
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font-size: 13px;
    transition: opacity .2s ease;
  }

  .contact-link + .contact-link {
    border-top: 0;
  }

  .contact-link:hover {
    opacity: .55;
  }

