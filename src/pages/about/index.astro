---
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const mediaUrl = (path) => path?.startsWith("/") ? `${base}${path.slice(1)}` : path;
---

<BaseLayout
  title="About Thomas Fredborg | Senior Art Director & Graphic Designer"
  description="About Thomas Fredborg, a Senior Art Director and Graphic Designer in Copenhagen and Zealand, working across brand identity, retail, packaging, digital, print and creative production."
  image="/media/Afslappet portræt i kreativt atelier.png"
  imageAlt="Thomas Fredborg — Senior Art Director & Graphic Designer"
>
  <section class="about-hero">
    <p class="eyebrow">About</p>
    <h1>I design systems that <em>work.</em></h1>
    <p class="lead">
      Senior Art Director & Graphic Designer with 13+ years of experience
      across branding, retail, packaging, editorial, campaigns, digital
      design and UI.
    </p>
  </section>

  <section class="about-main">
    <div class="profile">
      <figure class="portrait">
        <img src={mediaUrl("/media/Afslappet portræt i kreativt atelier.png")} alt="Thomas Fredborg — Graphic Designer and Art Director" loading="eager" decoding="async" />
      </figure>
      <span>Thomas Fredborg</span>
      <small>Senior Art Director · Graphic Designer</small>
    </div>

    <div class="content">
      <div class="intro">
        <h2>Good design is not only about the idea. It is about making the idea <em>work in the real world.</em></h2>
        <p>
          I enjoy working where creative thinking and practical execution need to
          meet. That can mean shaping a visual identity, building a retail system,
          developing packaging, designing digital experiences or taking a campaign
          all the way from first direction to finished production.
        </p>
        <p>
          A large part of my experience comes from projects with many formats,
          products, messages and stakeholders. My strength is turning that
          complexity into clear visual systems that are easy to understand,
          consistent across touchpoints and practical to produce.
        </p>
      </div>

      <div class="section-block">
        <p class="eyebrow">How I work</p>
        <div class="principles">
          <article><span>01</span><h3>Clarify the problem</h3><p>I start by understanding the brief, the audience, the constraints and what the design actually needs to achieve.</p></article>
          <article><span>02</span><h3>Build the system</h3><p>I turn the direction into a visual language that can hold together across formats, channels and applications.</p></article>
          <article><span>03</span><h3>Make it real</h3><p>I stay close to the practical side — artwork, production, coordination, suppliers and the details that make a solution usable.</p></article>
        </div>
      </div>

      <div class="section-block">
        <p class="eyebrow">Experience</p>
        <div class="experience-list">
          <div><strong>13+</strong><span>Years in design</span></div>
          <div><strong>Brand</strong><span>Identity · Visual direction · Campaigns</span></div>
          <div><strong>Retail</strong><span>Print · POS · Environmental graphics · Multi-brand systems</span></div>
          <div><strong>Digital</strong><span>UI · Digital design · Customer journeys</span></div>
          <div><strong>Production</strong><span>Artwork · Print · Supplier coordination · Delivery</span></div>
        </div>
      </div>

      <div class="section-block">
        <p class="eyebrow">Selected work</p>
        <div class="work-links">
          <a href={`${base}cases/pisiffik-loyalty-app/`}><span>Pisiffik Loyalty App</span><small>Digital · UI · Retail</small><span>↗</span></a>
          <a href={`${base}cases/flid/`}><span>FLID</span><small>Brand identity · Editorial</small><span>↗</span></a>
          <a href={`${base}cases/simple-life-trope/`}><span>Simple Life by Trope</span><small>Packaging · Illustration</small><span>↗</span></a>
          <a href={`${base}cases/fair-fitness/`}><span>Fair Fitness</span><small>Brand communication · Environmental</small><span>↗</span></a>
        </div>
      </div>

      <div class="about-cta">
        <p>Looking for a designer who can move between concept, systems and production?</p>
        <a href={`${base}#contact`}>Get in touch <span>↗</span></a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "AboutPage",
    name: "About Thomas Fredborg",
    url: Astro.url,
    mainEntity: { "@id": `${Astro.site?.toString() ?? "https://thomasfredborg.dk/"}#person` },
    description: "About Thomas Fredborg, a Senior Art Director and Graphic Designer working across branding, retail, packaging, digital design, print and creative production."
  })}></script>
</BaseLayout>

<style>
  .about-hero,
  .about-main {
    width: min(calc(100% - 56px), var(--max));
  }

  .about-hero {
    margin: var(--space-major) auto var(--space-major);
  }

  .about-hero h1 {
    margin: 0;
    max-width: 1180px;
    font-size: clamp(58px, 9vw, 138px);
    line-height: .9;
    font-weight: 500;
    letter-spacing: -.065em;
  }

  .about-hero h1 em,
  .intro h2 em {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    letter-spacing: -.045em;
  }

  .lead {
    max-width: 640px;
    margin: 56px 0 0 31%;
    font-size: clamp(20px, 2.3vw, 32px);
    line-height: 1.2;
    letter-spacing: -.025em;
  }

  .about-main {
    display: grid;
    grid-template-columns: .2fr .8fr;
    gap: 5vw;
    margin-bottom: var(--space-major);
  }

  .profile {
    min-width: 0;
    padding-left: clamp(12px, 2vw, 28px);
  }

  .portrait {
    width: 190px;
    height: 190px;
    margin: 0;
    border-radius: 50%;
    overflow: hidden;
    background: var(--card);
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
    display: block;
  }

  .profile > span,
  .profile > small {
    display: block;
    margin-top: 12px;
  }

  .profile > span {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .1em;
  }

  .profile > small {
    margin-top: 4px;
    font-size: 10px;
    color: var(--muted);
  }

  .content { min-width: 0; }

  .intro h2 {
    margin: 0;
    max-width: 1060px;
    font-size: clamp(38px, 5.2vw, 76px);
    line-height: .96;
    font-weight: 500;
    letter-spacing: -.05em;
  }

  .intro p {
    max-width: 720px;
    margin: 48px 0 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--muted);
  }

  .intro p + p { margin-top: 22px; }

  .section-block { margin-top: var(--space-major); }

  .principles { border-top: 1px solid var(--line); }

  .principles article {
    display: grid;
    grid-template-columns: 42px 220px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }

  .principles article > span {
    padding-top: 4px;
    font-size: 9px;
    color: var(--muted);
    letter-spacing: .1em;
  }

  .principles h3 {
    margin: 0;
    font-size: 15px;
    line-height: 1.3;
    font-weight: 600;
  }

  .principles p {
    margin: 0;
    max-width: 520px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted);
  }

  .experience-list { border-top: 1px solid var(--line); }

  .experience-list div {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 30px;
    padding: 17px 0;
    border-bottom: 1px solid var(--line);
  }

  .experience-list strong {
    font-size: 24px;
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -.03em;
  }

  .experience-list span {
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }

  .work-links { border-top: 1px solid var(--line); }

  .work-links a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px 24px;
    gap: 20px;
    align-items: center;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
    transition: opacity .2s ease;
  }

  .work-links a:hover { opacity: .55; }

  .work-links small {
    font-size: 10px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .about-cta {
    margin-top: var(--space-major);
    padding: 30px 0;
    border-top: 1px solid var(--fg);
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: 30px;
    align-items: baseline;
  }

  .about-cta p {
    margin: 0;
    max-width: 620px;
    font-size: 15px;
    line-height: 1.5;
  }

  .about-cta a {
    display: inline-flex;
    gap: 14px;
    align-items: center;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .09em;
    white-space: nowrap;
  }

  @media (max-width: 820px) {
    .about-hero,
    .about-main {
      width: min(calc(100% - 28px), var(--max));
    }

    .about-hero {
      margin-top: var(--space-section);
      margin-bottom: var(--space-section);
    }

    .about-hero h1 {
      font-size: clamp(50px, 13vw, 82px);
    }

    .lead {
      margin: 36px 0 0;
      font-size: 21px;
    }

    .about-main {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .profile {
      padding-left: 14px;
    }

    .portrait {
      width: 138px;
      height: 138px;
    }

    .intro p { font-size: 15px; }

    .section-block { margin-top: var(--space-section); }

    .principles article {
      grid-template-columns: 28px 1fr;
      gap: 12px;
    }

    .principles p {
      grid-column: 2;
    }

    .experience-list div {
      grid-template-columns: 100px 1fr;
      gap: 18px;
    }

    .work-links a {
      grid-template-columns: minmax(0, 1fr) 24px;
      gap: 12px;
    }

    .work-links small { grid-column: 1; }

    .work-links a > span:last-child {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: center;
    }

    .about-cta { display: block; }

    .about-cta a { margin-top: 22px; }
  }
</style>
